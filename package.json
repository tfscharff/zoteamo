{
  "name": "zoteamo",
  "version": "0.12.0",
  "private": true,
  "description": "Collaborative reading lists for reading groups: paste a URL, DOI or ISBN, get proper citations.",
  "license": "AGPL-3.0-or-later",
  "repository": "github:tfscharff/zoteamo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy && wrangler pages dev _site",
    "validate": "eleventy && html-validate \"_site/**/*.html\"",
    "test": "node --test \"tests/**/*.test.mjs\" && vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "ship": "node scripts/ship.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "html-validate": "^11.16.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  }
}
